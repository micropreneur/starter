# Auth adapter selection. Better Auth is the default when omitted.
AUTH_PROVIDER=betterauth

# Disabled-by-default authenticated Durable Object echo seam.
REALTIME_ENABLED=false

# Cloudflare D1. Create a real database before remote migrations and replace the
# local placeholder in apps/web/wrangler.jsonc.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=

# Better Auth. Required outside local development; use a random 32+ character
# secret. Worker runtime values live in apps/web/.dev.vars (see the example).
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Optional Google OAuth. Configure both or neither. Callback URL:
# http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email. Local captures action links in the dev terminal. Deployed environments
# must select Resend and set both production values.
EMAIL_PROVIDER=local
RESEND_API_KEY=
EMAIL_FROM=Micropreneur Starter <hello@example.com>

# Descope remains a typed 501 adapter seam in Free Starter.
DESCOPE_PROJECT_ID=
DESCOPE_MANAGEMENT_KEY=

# Stripe is intentionally off in Free Starter. Configure all three test-mode
# values together to activate the included one-plan billing engine in a fork.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Optional Turnstile abuse protection. Configure both or neither.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Build-time Vite flag for public demo deployments. Pass it in the build
# environment; it is not a Worker runtime secret. Keep false in normal forks.
VITE_PUBLIC_SANDBOX_MODE=false

# Public canonical origin used by page metadata, sitemap.xml, and robots.txt.
# Replace this when the fork moves to its own domain.
VITE_PUBLIC_SITE_URL=https://starter.micropreneur.dev

# Local MCP server configuration.
MCP_TRANSPORT=stdio
ELEMENTS_REGISTRY_URL=http://localhost:4173/r
