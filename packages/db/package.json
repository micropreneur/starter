{
  "name": "@micropreneur/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "pnpm --dir ../.. exec biome check packages/db",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "cross-env CI=true wrangler d1 migrations apply DB --local --config ../../apps/web/wrangler.jsonc",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote --config ../../apps/web/wrangler.jsonc"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260809.1",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.10",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.0"
  }
}
