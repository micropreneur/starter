{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "micropreneur-starter-docs",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "vars": {
    "PUBLIC_DOCS_ORIGIN": "http://localhost:3001",
    "ELEMENTS_REGISTRY_URL": "http://localhost:3001/r"
  }
}
