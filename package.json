{
  "name": "micropreneur-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "cf:deploy": "turbo cf:deploy",
    "db:generate": "turbo db:generate",
    "db:migrate": "turbo db:migrate",
    "docs:generate": "pnpm --filter docs agent:generate",
    "registry:build": "turbo registry:build",
    "audit:prod": "pnpm audit --prod --audit-level high",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@types/node": "^22.20.1",
    "turbo": "^2.10.9",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "overrides": {
      "@esbuild-kit/core-utils@3.3.2>esbuild": "0.25.12",
      "@hono/node-server": "2.0.10",
      "fast-uri": "3.1.5",
      "hono": "4.12.34",
      "ip-address": "10.3.1",
      "js-yaml": "4.3.1",
      "miniflare@4.20260730.0>undici": "7.29.0",
      "tsup@8.5.1>esbuild": "0.28.1"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss",
      "sharp",
      "workerd"
    ]
  }
}
